#!/bin/sh
set -eu

[ "${1:-}" = get ] || exit 0

protocol=
host=
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done

[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
token=$(gh auth token --hostname github.com --user pushnoi) || exit 1
printf 'username=pushnoi\npassword=%s\n' "$token"
