#!/bin/sh
set -eu

remote_name=${1:-}
remote_url=${2:-}

if [ "$remote_name" != origin ]; then
  echo 'Push blocked: Support Fins may only push to origin.' >&2
  exit 1
fi

case "$remote_url" in
  https://pushnoi@github.com/pushnoi/support-fins.git|https://github.com/pushnoi/support-fins.git)
    ;;
  *)
    echo 'Push blocked: origin must be pushnoi/support-fins over HTTPS.' >&2
    exit 1
    ;;
esac

if ! command -v gh >/dev/null 2>&1 || ! gh auth token --hostname github.com --user pushnoi >/dev/null 2>&1; then
  echo 'Push blocked: GitHub account pushnoi is unavailable in gh.' >&2
  exit 1
fi
